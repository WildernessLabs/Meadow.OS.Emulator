#!/bin/bash
# Minimal kconfig-tweak shim for NuttX configure.sh
# Implements --enable, --disable, --set-str, --set-val, --file options

FILE=""
ACTION=""
CONFIG=""
VALUE=""

while [[ $# -gt 0 ]]; do
    case "$1" in
        --file)
            FILE="$2"
            shift 2
            ;;
        --enable)
            ACTION="enable"
            CONFIG="$2"
            shift 2
            ;;
        --disable|-d)
            ACTION="disable"
            CONFIG="$2"
            shift 2
            ;;
        --undefine|-u)
            ACTION="disable"
            CONFIG="$2"
            shift 2
            ;;
        --set-str)
            ACTION="set-str"
            CONFIG="$2"
            VALUE="$3"
            shift 3
            ;;
        --set-val)
            ACTION="set-val"
            CONFIG="$2"
            VALUE="$3"
            shift 3
            ;;
        *)
            shift
            ;;
    esac
done

if [ -z "$FILE" ] || [ -z "$ACTION" ] || [ -z "$CONFIG" ]; then
    exit 0
fi

# Like the real kconfig-tweak, accept the option with or without its CONFIG_
# prefix.  Meadow.OS's build.sh (ktweak) passes bare names such as DEV_CONSOLE;
# without this they were appended to .config unprefixed, which Kconfig ignores,
# so every emulator setting (console, HCOM on UART4) was silently dropped.
case "$CONFIG" in
    CONFIG_*) ;;
    *) CONFIG="CONFIG_${CONFIG}" ;;
esac

set_config_value() {
    local key="$1"
    local val="$2"
    if grep -q "^# ${key} is not set" "$FILE" 2>/dev/null; then
        sed -i '' "s|^# ${key} is not set|${key}=${val}|" "$FILE"
    elif grep -q "^${key}=" "$FILE" 2>/dev/null; then
        sed -i '' "s|^${key}=.*|${key}=${val}|" "$FILE"
    else
        echo "${key}=${val}" >> "$FILE"
    fi
}

if [ "$ACTION" = "enable" ]; then
    set_config_value "$CONFIG" "y"
elif [ "$ACTION" = "disable" ]; then
    if grep -q "^${CONFIG}=" "$FILE" 2>/dev/null; then
        sed -i '' "s|^${CONFIG}=.*|# ${CONFIG} is not set|" "$FILE"
    fi
elif [ "$ACTION" = "set-str" ]; then
    set_config_value "$CONFIG" "\"${VALUE}\""
elif [ "$ACTION" = "set-val" ]; then
    set_config_value "$CONFIG" "$VALUE"
fi
