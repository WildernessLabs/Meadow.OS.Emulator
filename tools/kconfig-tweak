#!/bin/bash
# Minimal kconfig-tweak shim for NuttX configure.sh
# Implements --enable, --disable, --file options

FILE=""
ACTION=""
CONFIG=""

while [[ $# -gt 0 ]]; do
    case "$1" in
        --file)
            FILE="$2"
            shift 2
            ;;
        --enable)
            ACTION="enable"
            CONFIG="$2"
            shift 2
            ;;
        --disable)
            ACTION="disable"
            CONFIG="$2"
            shift 2
            ;;
        *)
            shift
            ;;
    esac
done

if [ -z "$FILE" ] || [ -z "$ACTION" ] || [ -z "$CONFIG" ]; then
    exit 0
fi

if [ "$ACTION" = "enable" ]; then
    if grep -q "^# ${CONFIG} is not set" "$FILE" 2>/dev/null; then
        sed -i '' "s/^# ${CONFIG} is not set/${CONFIG}=y/" "$FILE"
    elif grep -q "^${CONFIG}=" "$FILE" 2>/dev/null; then
        sed -i '' "s/^${CONFIG}=.*/${CONFIG}=y/" "$FILE"
    else
        echo "${CONFIG}=y" >> "$FILE"
    fi
elif [ "$ACTION" = "disable" ]; then
    if grep -q "^${CONFIG}=" "$FILE" 2>/dev/null; then
        sed -i '' "s/^${CONFIG}=.*/# ${CONFIG} is not set/" "$FILE"
    fi
fi
