# Mono trampoline fix: subtract 0x20 from ip to correct for missing .mono_signature header
# The nuttx_mono.bin starts with the .mono code section (linker address 0xC0000020)
# but is loaded at 0xC0000000, shifting all code 0x20 bytes down. Trampolines in user
# flash target ELF addresses (based on 0xC0000020), so they land 0x20 bytes too high.
# Fix: hook each bx ip in the trampoline table and subtract 0x20 from ip.
# 174 trampolines from 0x08105CB8 to 0x0810637A
set tramp_fix "from Antmicro.Renode.Peripherals.CPU import RegisterValue; ip = cpu.GetRegisterUnsafe(12).RawValue; cpu.SetRegisterUnsafe(12, RegisterValue.Create(ip - 0x20, 32))"
cpu AddHook 0x08105CB8 $tramp_fix
cpu AddHook 0x08105CC2 $tramp_fix
cpu AddHook 0x08105CCC $tramp_fix
cpu AddHook 0x08105CD6 $tramp_fix
cpu AddHook 0x08105CE0 $tramp_fix
cpu AddHook 0x08105CEA $tramp_fix
cpu AddHook 0x08105CF4 $tramp_fix
cpu AddHook 0x08105CFE $tramp_fix
cpu AddHook 0x08105D08 $tramp_fix
cpu AddHook 0x08105D12 $tramp_fix
cpu AddHook 0x08105D1C $tramp_fix
cpu AddHook 0x08105D26 $tramp_fix
cpu AddHook 0x08105D30 $tramp_fix
cpu AddHook 0x08105D3A $tramp_fix
cpu AddHook 0x08105D44 $tramp_fix
cpu AddHook 0x08105D4E $tramp_fix
