using sysbus
include @peripherals/Winbond_W25QXXXJV.cs
include @peripherals/STM32F7_RCC_Custom.cs
mach create "meadow"
machine LoadPlatformDescription @platforms/meadow-f7.repl

# RCC peripheral with proper clock ready bit handling
machine LoadPlatformDescriptionFromString "rcc: Miscellaneous.STM32F7_RCC_Custom @ sysbus 0x40023800"

# USB OTG FS stub — handles GRSTCTL polling (AHBIDL bit)
machine PyDevFromFile @scripts/pydev/otg_fs.py 0x50000000 0x40000 true "otg_fs"

# Load kernel at link-time address (0x08000000)
sysbus LoadBinary @build/nuttx.bin 0x08000000
# Load user binary at 0x08100000 (CONFIG_NUTTX_USERSPACE)
sysbus LoadBinary @build/nuttx_user.bin 0x08100000

sysbus.cpu VectorTableOffset 0x08000000

# USART1: Console/syslog output to file
usart1 CreateFileBackend @/tmp/renode-uart.txt true

# UART4: HCOM transport — exposed as TCP socket on port 4242
emulation CreateServerSocketTerminal 4242 "hcom" false
connector Connect sysbus.uart4 hcom

# Workaround: Renode skips SVC when PRIMASK=1 instead of escalating to HardFault.
set svc_fix "from Antmicro.Renode.Peripherals.CPU import RegisterValue; cpu.PRIMASK = RegisterValue.Create(0, 32)"
cpu AddHook 0x08002258 $svc_fix
cpu AddHook 0x08036080 $svc_fix
cpu AddHook 0x08036372 $svc_fix
cpu AddHook 0x08036610 $svc_fix
cpu AddHook 0x0803665a $svc_fix
cpu AddHook 0x080368bc $svc_fix
cpu AddHook 0x080616a2 $svc_fix

# Workaround: Force GPIO board version to CCMv2 (0x01).
set gpio_ver_fix "sp = cpu.GetRegisterUnsafe(13).RawValue; machine.SystemBus.WriteDoubleWord(sp + 12, 0x01)"
cpu AddHook 0x08002c60 $gpio_ver_fix

# Workaround: Renode's STM32H7_QuadSPI doesn't set TCF in SR.
set qspi_wait_skip "cpu.PC = cpu.LR"
cpu AddHook 0x08033f74 $qspi_wait_skip

# Workaround: QUADSPI doesn't drive DMA requests.
set qspi_dma_bypass "meminfo = cpu.GetRegisterUnsafe(1).RawValue; flags = machine.SystemBus.ReadDoubleWord(meminfo) & 0xFF; buflen = machine.SystemBus.ReadDoubleWord(meminfo + 8); faddr = machine.SystemBus.ReadDoubleWord(meminfo + 12); buf = machine.SystemBus.ReadDoubleWord(meminfo + 20); is_write = flags & 0x04; data = machine.SystemBus.ReadBytes(buf, int(buflen)) if is_write else machine.SystemBus.ReadBytes(0x90000000 + faddr, int(buflen)); machine.SystemBus.WriteBytes(data, 0x90000000 + faddr) if is_write else machine.SystemBus.WriteBytes(data, buf); cpu.PC = cpu.LR"
cpu AddHook 0x0803415c $qspi_dma_bypass

# Fix return value for DMA bypass.
set qspi_dma_fixret "sp = cpu.GetRegisterUnsafe(13).RawValue; machine.SystemBus.WriteDoubleWord(sp + 44, 0)"
cpu AddHook 0x080346c8 $qspi_dma_fixret

# Workaround: LSI clock calibration thread polls Timer 5 capture/compare which
# Renode doesn't emulate. Skip the thread function to avoid burning CPU.
set lsi_skip "cpu.PC = cpu.LR"
cpu AddHook 0x0800e07c $lsi_skip

start
