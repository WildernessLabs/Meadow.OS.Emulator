## Meadow Dual-Machine — STM32 F7 + ESP32, connected via SpiBridge
##
## This script boots both the NuttX legacy OS on the STM32 and the
## Meadow ESP-IDF firmware on the ESP32, with SpiBridge replacing
## EspcpStub on SPI2 for cross-machine ESPCP communication.
##
## Usage:
##   ./run.sh meadow-dual
##   OR:
##   dotnet path/to/Renode.dll --console --disable-xwt \
##     -e 'include @scripts/meadow-dual.resc'

# =============================================================================
# Compile shared C# peripherals (must be before any machine creation)
# =============================================================================
include @peripherals/Winbond_W25QXXXJV.cs
include @peripherals/SpiBridge.cs
include @peripherals/QspiDmaBypass.cs
include @peripherals/SvcPrimaskFix.cs
include @peripherals/MqReceiveIntercept.cs
include @peripherals/ESP32_RTC_CNTL.cs
include @peripherals/ESP32_TimerGroup.cs
include @peripherals/ESP32_DPORT.cs
include @peripherals/ESP32_SPI.cs
include @peripherals/XtensaHotPathHooks.cs

# =============================================================================
# Machine 1: STM32 F7 — NuttX Meadow Legacy OS
# =============================================================================
mach create "stm32"
machine LoadPlatformDescription @platforms/meadow-f7-dual.repl

# STM32 needs enough virtual time to boot NuttX and start the HCOM handler.
# Without this, the ESP32 machine consumes all execution time (heavy Python
# hooks for window overflow workarounds) and the STM32 barely advances.
cpu PerformanceInMips 100

using sysbus

# RCC peripheral with proper clock ready bit handling
machine PyDevFromFile @scripts/pydev/rcc.py 0x40023800 0x400 true "rcc"

# USB OTG FS stub — handles GRSTCTL polling (AHBIDL bit)
machine PyDevFromFile @scripts/pydev/otg_fs.py 0x50000000 0x40000 true "otg_fs"

# FMC (Flexible Memory Controller) stub — SDRAM init writes to 0xA0000000
machine PyDevFromFile @scripts/pydev/fmc.py 0xA0000000 0x1000 true "fmc"

# SpiBridge — starts booted and ready
sysbus.spi2.spiBridge Reset

# Legacy memory layout
sysbus LoadBinary @build/legacy/nuttx_user.bin 0x08040000
sysbus LoadBinary @build/legacy/nuttx_vectors.bin 0x08040000
sysbus LoadBinary @build/legacy/nuttx_kernel.bin 0x08140000

# Mono runtime — load into QSPI flash and SDRAM
sysbus LoadBinary @build/legacy/nuttx_mono.bin 0x90000000
sysbus LoadBinary @build/legacy/nuttx_mono.bin 0xC0000000

# LittleFS filesystem image (optional — may not exist in build)
# sysbus LoadBinary @build/legacy/littlefs.bin 0x90500000

sysbus.cpu VectorTableOffset 0x08040000

# USART1: Console/syslog output
showAnalyzer usart1

# UART4: HCOM transport — exposed as TCP socket on port 4242
emulation CreateServerSocketTerminal 4242 "hcom" false
connector Connect sysbus.uart4 hcom

# UART5: ESP32 control signal channel — exposed as TCP socket on port 4243
emulation CreateServerSocketTerminal 4243 "esp32ctrl" false
connector Connect sysbus.uart5 esp32ctrl

# Hook definitions and SDRAM patches (auto-generated with resolved addresses)
# NOTE: hooks.resc registers espcp_spi_bypass targeting EspcpStub. We override it below.
include @build/legacy/hooks.resc
include @build/legacy/sdram-patches.resc

# Override espcp_spi_bypass: use SpiBridge instead of EspcpStub.
# AddHook stacks, so both hooks will fire. The EspcpStub one will crash but we catch it.
# Better approach: use cpu RemoveHooksAt to clear the old hook, then add ours.
cpu RemoveHooksAt 0x081488A0
set espcp_spi_bypass_dual "from System import Array, Byte; stub = machine['sysbus.spi2.spiBridge']; tx = cpu.GetRegisterUnsafe(0).RawValue; rx = cpu.GetRegisterUnsafe(1).RawValue; length = int(cpu.GetRegisterUnsafe(2).RawValue); txdata = machine.SystemBus.ReadBytes(tx, length) if tx else Array.CreateInstance(Byte, length); rxarr = Array.CreateInstance(Byte, length); [rxarr.__setitem__(i, stub.Transmit(txdata[i])) for i in range(length)]; stub.FinishTransmission(); machine.SystemBus.WriteBytes(rxarr, rx) if rx else None; cpu.PC = cpu.LR"
cpu AddHook 0x081488A0 $espcp_spi_bypass_dual

# =============================================================================
# Machine 2: ESP32 — Meadow ESP-IDF Firmware
# =============================================================================
mach create "esp32"
machine LoadPlatformDescription @platforms/meadow-esp32.repl

# Reduce ESP32 MIPS relative to STM32 (100 MIPS) so the STM32 gets enough
# virtual time to boot NuttX and run the HCOM handler. Without this ratio,
# the ESP32's heavy Python hooks (window overflow workarounds, SPI fixups)
# starve the STM32 of execution time.
cpu PerformanceInMips 10

using sysbus

# Set up UART terminal on port 4245
emulation CreateServerSocketTerminal 4245 "esp32uart" false
connector Connect uart0 esp32uart

# Load the ESP32 ROM binary at 0x40000000
sysbus LoadBinary @roms/esp32-v3-rom.bin 0x40000000

# Load the Meadow ESP32 firmware ELF
# ESP32 firmware ELF — set via run.sh --esp32, or default to sibling Meadow-ESP32 repo
$esp32_fw?=@../Meadow-ESP32/build/MeadowComms.elf
sysbus LoadELF $esp32_fw

# Window register init trampoline — relocated to 0x400A0300 (past IRAM text end).
# Original was at 0x4009F000 which OVERWRITES spi_slave_hal_user_start (0x4009F000)
# and spi_slave_hal_prepare_data (0x4009F028)!
# Literal pool at 0x400A0300-0x400A030B:
#   +0x00: entry point address (0x40081BBC = call_start_cpu0)
#   +0x04: initial SP (0x3FFE5F00)
#   +0x08: initial PS (0x00040000 = WOE|CALLINC=0)
# Code at 0x400A030C:
#   movi a0, 0; wsr.windowbase a0; rsync
#   movi a0, 1; wsr.windowstart a0; rsync
#   l32r a0, [PS]; wsr.ps a0; rsync
#   l32r a1, [SP]; l32r a8, [entry]; movi a0, 0; callx8 a8
# Entry point
sysbus WriteDoubleWord 0x400A0300 0x40081BBC
# SP
sysbus WriteDoubleWord 0x400A0304 0x3FFE5F00
# PS = WOE | CALLINC(0) = 0x00040000
sysbus WriteDoubleWord 0x400A0308 0x00040000
# Code: movi a0, 0 (0C 00)
sysbus WriteByte 0x400A030C 0x0C
sysbus WriteByte 0x400A030D 0x00
# wsr.windowbase a0 (00 48 13)
sysbus WriteByte 0x400A030E 0x00
sysbus WriteByte 0x400A030F 0x48
sysbus WriteByte 0x400A0310 0x13
# rsync (00 20 00)
sysbus WriteByte 0x400A0311 0x00
sysbus WriteByte 0x400A0312 0x20
sysbus WriteByte 0x400A0313 0x10
# movi a0, 1 (0C 10)
sysbus WriteByte 0x400A0314 0x0C
sysbus WriteByte 0x400A0315 0x10
# wsr.windowstart a0 (00 49 13)
sysbus WriteByte 0x400A0316 0x00
sysbus WriteByte 0x400A0317 0x49
sysbus WriteByte 0x400A0318 0x13
# rsync (00 20 00)
sysbus WriteByte 0x400A0319 0x00
sysbus WriteByte 0x400A031A 0x20
sysbus WriteByte 0x400A031B 0x10
# l32r a0, [0x400A0308] = PS literal
# l32r offset = (0x400A0308 - (0x400A031C & ~3)) / (-4) + 1 ... complex
# Actually let me just use the original trampoline bytes with adjusted l32r offsets
# Simpler: use movi for PS since it fits in 12-bit immediate
# movi a0, 0 — then wsr.ps a0 — but PS needs WOE bit (0x40000)
# PS=0x00040000 doesn't fit movi. Use l32r.
# l32r a0, literal: byte0 = (reg << 4) | 0x01, offset encodes the literal distance
# For l32r at 0x400A031C targeting 0x400A0308:
#   offset = (0x400A0308 - ((0x400A031C + 3) & ~3)) >> 2 ... actually l32r uses:
#   addr = ((PC+3) & ~3) + (sign_extend(imm16) << 2)
#   imm16 = (addr - ((PC+3) & ~3)) >> 2
# PC = 0x400A031C, (PC+3)&~3 = 0x400A031C (already aligned)
# imm16 = (0x400A0308 - 0x400A031C) >> 2 = (-0x14) >> 2 = -5 = 0xFFFB (16-bit signed)
# l32r a0: byte0 = (0 << 4) | 1 = 0x01, byte1 = 0xFB, byte2 = 0xFF
sysbus WriteByte 0x400A031C 0x01
sysbus WriteByte 0x400A031D 0xFB
sysbus WriteByte 0x400A031E 0xFF
# wsr.ps a0 (00 E6 13)
sysbus WriteByte 0x400A031F 0x00
sysbus WriteByte 0x400A0320 0xE6
sysbus WriteByte 0x400A0321 0x13
# rsync
sysbus WriteByte 0x400A0322 0x00
sysbus WriteByte 0x400A0323 0x20
sysbus WriteByte 0x400A0324 0x10
# l32r a1, [0x400A0304] = SP literal
# PC = 0x400A0325, (PC+3)&~3 = 0x400A0328
# imm16 = (0x400A0304 - 0x400A0328) >> 2 = (-0x24) >> 2 = -9 = 0xFFF7
# l32r a1: byte0 = (1 << 4) | 1 = 0x11, byte1 = 0xF7, byte2 = 0xFF
sysbus WriteByte 0x400A0325 0x11
sysbus WriteByte 0x400A0326 0xF7
sysbus WriteByte 0x400A0327 0xFF
# l32r a8, [0x400A0300] = entry point literal
# PC = 0x400A0328, (PC+3)&~3 = 0x400A032C
# imm16 = (0x400A0300 - 0x400A032C) >> 2 = (-0x2C) >> 2 = -11 = 0xFFF5
# l32r a8: byte0 = (8 << 4) | 1 = 0x81, byte1 = 0xF5, byte2 = 0xFF
sysbus WriteByte 0x400A0328 0x81
sysbus WriteByte 0x400A0329 0xF5
sysbus WriteByte 0x400A032A 0xFF
# movi a0, 0 (0C 00)
sysbus WriteByte 0x400A032B 0x0C
sysbus WriteByte 0x400A032C 0x00
# callx8 a8 (E0 08 00)
sysbus WriteByte 0x400A032D 0xE0
sysbus WriteByte 0x400A032E 0x08
sysbus WriteByte 0x400A032F 0x00
# DISABLED — using register API instead (see below)
# cpu PC 0x400A030C

# ACTUALLY: skip the whole trampoline. Just init registers directly.
# The trampoline code at 0x400A0300 sets WINDOWBASE/WINDOWSTART/PS/SP then
# callx8 to the firmware entry. We can do this with Renode register API:
cpu SetRegister "WINDOWBASE" 0
cpu SetRegister "WINDOWSTART" 1
cpu SetRegister "PS" 0x00040000
cpu SetRegister "A1" 0x3FFE5F00
cpu PC 0x40081BBC

# Set VECBASE to the firmware's exception vectors in IRAM
cpu SetRegister "VECBASE" 0x40080000

# =============================================================================
# ESP32 binary patches — all the same patches from esp32-meadow-boot-no-retw-hooks.resc
# =============================================================================

# NOP _xtos_set_intlevel calls (10 callx8 sites)
sysbus WriteByte 0x40081EE3 0x82
sysbus WriteByte 0x40081EE4 0xC0
sysbus WriteByte 0x40081EE5 0x00
sysbus WriteByte 0x40081F57 0x82
sysbus WriteByte 0x40081F58 0xC0
sysbus WriteByte 0x40081F59 0x00
sysbus WriteByte 0x40081FA3 0x82
sysbus WriteByte 0x40081FA4 0xC0
sysbus WriteByte 0x40081FA5 0x00
sysbus WriteByte 0x4008AAFE 0x82
sysbus WriteByte 0x4008AAFF 0xC0
sysbus WriteByte 0x4008AB00 0x00
sysbus WriteByte 0x4008AB73 0x82
sysbus WriteByte 0x4008AB74 0xC0
sysbus WriteByte 0x4008AB75 0x00
sysbus WriteByte 0x4008AC6E 0x82
sysbus WriteByte 0x4008AC6F 0xC0
sysbus WriteByte 0x4008AC70 0x00
sysbus WriteByte 0x4008AD52 0x82
sysbus WriteByte 0x4008AD53 0xC0
sysbus WriteByte 0x4008AD54 0x00
sysbus WriteByte 0x4008ADDF 0x82
sysbus WriteByte 0x4008ADE0 0xC0
sysbus WriteByte 0x4008ADE1 0x00
sysbus WriteByte 0x400910DE 0x82
sysbus WriteByte 0x400910DF 0xC0
sysbus WriteByte 0x400910E0 0x00
sysbus WriteByte 0x40091225 0x82
sysbus WriteByte 0x40091226 0xC0
sysbus WriteByte 0x40091227 0x00

# Fix INTLEVEL in FreeRTOS lock functions
sysbus WriteByte 0x40082c49 0xB2
sysbus WriteByte 0x40082c4a 0xA0
sysbus WriteByte 0x40082c4b 0x00
sysbus WriteByte 0x40082ca7 0xB2
sysbus WriteByte 0x40082ca8 0xA0
sysbus WriteByte 0x40082ca9 0x00

# vTaskSwitchContext exit trampoline (27 bytes)
sysbus WriteByte 0x40092C33 0x80
sysbus WriteByte 0x40092C34 0x48
sysbus WriteByte 0x40092C35 0x03
sysbus WriteByte 0x40092C36 0x82
sysbus WriteByte 0x40092C37 0xC8
sysbus WriteByte 0x40092C38 0xFF
sysbus WriteByte 0x40092C39 0x92
sysbus WriteByte 0x40092C3A 0xA0
