## Meadow Dual-Machine — STM32 F7 + ESP32, connected via SpiBridge
##
## This script boots both the NuttX legacy OS on the STM32 and the
## Meadow ESP-IDF firmware on the ESP32, with SpiBridge replacing
## EspcpStub on SPI2 for cross-machine ESPCP communication.
##
## Usage:
##   ./run.sh meadow-dual
##   OR:
##   dotnet path/to/Renode.dll --console --disable-xwt \
##     -e 'include @scripts/meadow-dual.resc'

# =============================================================================
# Compile shared C# peripherals (must be before any machine creation)
# =============================================================================
include @peripherals/Winbond_W25QXXXJV.cs
include @peripherals/SpiBridge.cs
include @peripherals/QspiDmaBypass.cs
include @peripherals/SvcPrimaskFix.cs
include @peripherals/MqReceiveIntercept.cs
include @peripherals/ESP32_RTC_CNTL.cs
include @peripherals/ESP32_TimerGroup.cs
include @peripherals/ESP32_DPORT.cs

# =============================================================================
# Machine 1: STM32 F7 — NuttX Meadow Legacy OS
# =============================================================================
mach create "stm32"
machine LoadPlatformDescription @platforms/meadow-f7-dual.repl

using sysbus

# RCC peripheral with proper clock ready bit handling
machine PyDevFromFile @scripts/pydev/rcc.py 0x40023800 0x400 true "rcc"

# USB OTG FS stub — handles GRSTCTL polling (AHBIDL bit)
machine PyDevFromFile @scripts/pydev/otg_fs.py 0x50000000 0x40000 true "otg_fs"

# FMC (Flexible Memory Controller) stub — SDRAM init writes to 0xA0000000
machine PyDevFromFile @scripts/pydev/fmc.py 0xA0000000 0x1000 true "fmc"

# SpiBridge — starts booted and ready
sysbus.spi2.spiBridge Reset

# Legacy memory layout
sysbus LoadBinary @build/legacy/nuttx_user.bin 0x08040000
sysbus LoadBinary @build/legacy/nuttx_vectors.bin 0x08040000
sysbus LoadBinary @build/legacy/nuttx_kernel.bin 0x08140000

# Mono runtime — load into QSPI flash and SDRAM
sysbus LoadBinary @build/legacy/nuttx_mono.bin 0x90000000
sysbus LoadBinary @build/legacy/nuttx_mono.bin 0xC0000000

# LittleFS filesystem image (optional — may not exist in build)
# sysbus LoadBinary @build/legacy/littlefs.bin 0x90500000

sysbus.cpu VectorTableOffset 0x08040000

# USART1: Console/syslog output
showAnalyzer usart1

# UART4: HCOM transport — exposed as TCP socket on port 4242
emulation CreateServerSocketTerminal 4242 "hcom" false
connector Connect sysbus.uart4 hcom

# UART5: ESP32 control signal channel — exposed as TCP socket on port 4243
emulation CreateServerSocketTerminal 4243 "esp32ctrl" false
connector Connect sysbus.uart5 esp32ctrl

# Hook definitions and SDRAM patches (auto-generated with resolved addresses)
include @build/legacy/hooks.resc
include @build/legacy/sdram-patches.resc

# =============================================================================
# Machine 2: ESP32 — Meadow ESP-IDF Firmware
# =============================================================================
mach create "esp32"
machine LoadPlatformDescription @platforms/meadow-esp32.repl

using sysbus

# Set up UART terminal on port 4245
emulation CreateServerSocketTerminal 4245 "esp32uart" false
connector Connect uart0 esp32uart

# Load the ESP32 ROM binary at 0x40000000
sysbus LoadBinary @roms/esp32-v3-rom.bin 0x40000000

# Load the Meadow ESP32 firmware ELF
sysbus LoadELF @/Users/bryancostanich/Git_Repos/Wilderness_Labs/Meadow.OS/esp32/build/MeadowComms.elf

# Window register init trampoline
sysbus LoadELF @tests/trampoline/trampoline.elf
cpu PC 0x4009F00C

# Set VECBASE to the firmware's exception vectors in IRAM
cpu SetRegister "VECBASE" 0x40080000

# =============================================================================
# ESP32 binary patches — all the same patches from esp32-meadow-boot-no-retw-hooks.resc
# =============================================================================

