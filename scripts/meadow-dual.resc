sysbus WriteByte 0x401B0356 0x25

# __assert_func → retw.n
sysbus WriteByte 0x40199DA3 0x1D
sysbus WriteByte 0x40199DA4 0xF0

# esp_crosscore_int_send_yield → j vPortYield
sysbus WriteByte 0x40081E28 0x06
sysbus WriteByte 0x40081E29 0x60
sysbus WriteByte 0x40081E2A 0x3D

# Flash function skips
sysbus WriteByte 0x4013565B 0x1D
sysbus WriteByte 0x4013565C 0xF0
sysbus WriteByte 0x4008A193 0x1D
sysbus WriteByte 0x4008A194 0xF0
sysbus WriteByte 0x4008A1BF 0x1D
sysbus WriteByte 0x4008A1C0 0xF0
sysbus WriteByte 0x4008A393 0x1D
sysbus WriteByte 0x4008A394 0xF0
sysbus WriteByte 0x4008A123 0x1D
