using sysbus
include @peripherals/Winbond_W25QXXXJV.cs
include @peripherals/EspcpStub.cs
include @peripherals/STM32F7_RCC_Custom.cs
include @peripherals/QspiDmaBypass.cs
include @peripherals/EspcpSpiBypass.cs
include @peripherals/MqReceiveIntercept.cs
mach create "meadow"
machine LoadPlatformDescription @platforms/meadow-f7.repl

# RCC peripheral with proper clock ready bit handling
machine LoadPlatformDescriptionFromString "rcc: Miscellaneous.STM32F7_RCC_Custom @ sysbus 0x40023800"

# USB OTG FS stub — handles GRSTCTL polling (AHBIDL bit).  build.sh --emulator
# removes the USB device, but the stub is harmless and covers any probing.
machine PyDevFromFile @scripts/pydev/otg_fs.py 0x50000000 0x40000 true "otg_fs"

# FMC (Flexible Memory Controller) stub — SDRAM init writes to 0xA0000000
machine PyDevFromFile @scripts/pydev/fmc.py 0xA0000000 0x1000 true "fmc"

# ESP32 coprocessor stub — starts booted and ready for SPI
# Re-trigger Reset after platform load so Ready/MessageWaiting GPIOs propagate
sysbus.spi2.espcpStub Reset

# Meadow.OS (Rebase) memory layout — the same as Legacy (no bootloader is
# loaded; the CPU starts straight at the kernel vectors):
#   vectors at 0x08040000 (uflash), kernel text at 0x08140000 (kflash),
#   user code at 0x08040200+ (CONFIG_NUTTX_USERSPACE, after the vector table)
# Load the user binary first, then overlay the vector table on top of it.
#
# Mono runtime: nuttx_mono.bin is the .mono_signature followed by the .mono
# sections linked at 0xC0000000 (HCOM_NX_MONO_RUNTIME_SDRAM_ADDR).  Load it into
# the QSPI raw Mono partition (offset 0) for the kernel's flash reads, and into
# SDRAM at the link address.
#
# Reset macro — called by Renode on SYSRESETREQ (NVIC AIRCR write).  Reloads the
# images and the vector table so the firmware boots cleanly after a restart.
macro reset
"""
    sysbus LoadBinary @build/nuttx_user.bin 0x08040000
    sysbus LoadBinary @build/nuttx_vectors.bin 0x08040000
    sysbus LoadBinary @build/nuttx_kernel.bin 0x08140000
    sysbus LoadBinary @build/nuttx_mono.bin 0x90000000
    sysbus LoadBinary @build/nuttx_mono.bin 0xC0000000
    sysbus.cpu VectorTableOffset 0x08040000
    sysbus.spi2.espcpStub Reset
    # Patch Mono's compiled-in /usr/local paths to /meadow0 (auto-generated)
    include @build/sdram-patches.resc
"""
runMacro $reset

# LittleFS v2 file system image: run.sh --mount=FILE (default none, the firmware
# formats an empty partition).  run.sh writes build/fs-image.resc on every run.
# Load it once here, never in the reset macro, or a reset would overwrite files
# deployed by Meadow.CLI.
include @build/fs-image.resc

# GDB server: run.sh --gdb[=PORT] or ports.gdb in the config (default off).
# run.sh writes this file on every run.
include @build/gdb.resc

# USART1: Console/syslog output to file (debug.console_log in configs/meadow-os.yaml)
usart1 CreateFileBackend @/tmp/renode-uart-meadow.txt true

# UART4: HCOM transport — exposed as TCP socket on port 4242
# Connect with: meadow config route socket://localhost:4242
emulation CreateServerSocketTerminal 4242 "hcom" false
connector Connect sysbus.uart4 hcom

# UART5: ESP32 control signal channel — exposed as TCP socket on port 4243
emulation CreateServerSocketTerminal 4243 "esp32ctrl" false
connector Connect sysbus.uart5 esp32ctrl

# =============================================================================
# Hook definitions (auto-generated with resolved addresses)
# Template: scripts/meadow-legacy-hooks.resc (shared with legacy — same C
# symbol names since Rebase carries the same driver/subsystem code)
# Generated by: tools/extract-hook-addresses.py
# =============================================================================
include @build/hooks.resc

start
