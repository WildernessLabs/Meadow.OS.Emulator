using sysbus
include @peripherals/Winbond_W25QXXXJV.cs
include @peripherals/EspcpStub.cs
include @peripherals/STM32F7_RCC_Custom.cs
include @peripherals/QspiDmaBypass.cs
include @peripherals/EspcpSpiBypass.cs
include @peripherals/MqReceiveIntercept.cs
mach create "meadow"
machine LoadPlatformDescription @platforms/meadow-f7.repl

# RCC peripheral with proper clock ready bit handling
machine LoadPlatformDescriptionFromString "rcc: Miscellaneous.STM32F7_RCC_Custom @ sysbus 0x40023800"

# USB OTG FS stub — handles GRSTCTL polling (AHBIDL bit)
machine PyDevFromFile @scripts/pydev/otg_fs.py 0x50000000 0x40000 true "otg_fs"

# Load kernel at link-time address (0x08000000)
sysbus LoadBinary @build/nuttx.bin 0x08000000
# Load user binary at 0x08100000 (CONFIG_NUTTX_USERSPACE)
sysbus LoadBinary @build/nuttx_user.bin 0x08100000

# NOTE: Mono isn't integrated into Meadow.OS (Rebase) yet — the linker script reserves
# a .mono_signature placeholder at 0xC0000000 (which is why nuttx_user.bin needs its
# Mono/SDRAM sections stripped at all — see build-meadow.os-emulated.sh), but there's no
# actual .mono runtime code to load. Once Mono is integrated, add the same
# `sysbus LoadBinary @build/nuttx_mono.bin 0x90000000`/`0xC0000000` pair the legacy
# script (meadow-legacy-headless.resc) uses.

sysbus.cpu VectorTableOffset 0x08000000

# USART1: Console/syslog output (interactive terminal)
showAnalyzer usart1

# UART4: HCOM transport — exposed as TCP socket on port 4242
# Connect with: nc localhost 4242 (or use tools/hcom_test.py)
emulation CreateServerSocketTerminal 4242 "hcom" false
connector Connect sysbus.uart4 hcom

# Log UART output to file (uncomment to enable)
# usart1 CreateFileBackend @/tmp/uart1.txt true

# GDB server on port 3333 (uncomment to enable)
# machine StartGdbServer 3333

# =============================================================================
# Hook definitions and SDRAM patches (auto-generated with resolved addresses)
# Template: scripts/meadow-legacy-hooks.resc (shared with legacy — same C
# symbol names since Rebase carries the same driver/subsystem code)
# Generated by: tools/extract-hook-addresses.py
# =============================================================================
include @build/hooks.resc
include @build/sdram-patches.resc

start
