sysbus WriteByte 0x4009F067 0x6B
sysbus WriteByte 0x4009F068 0x01
sysbus WriteByte 0x4009F069 0xD2   # s32i a13, a11, 8    (pxNewListItem->pxPrevious = pxPrev)
sysbus WriteByte 0x4009F06A 0x6B
