# Non-windowed vListInsertEnd at 0x4009F060 (48 bytes, all wide instructions).
# No entry/retw — operates in caller's register window. Avoids Renode retw.n bug.
# After call8: a8=return_addr(+CALLINC), a10=pxList, a11=pxNewListItem.
# Uses a8-a13 (caller-saved). Returns via jx after stripping CALLINC bits.
# NOTE: objdump shows hex MSB-first; memory is little-endian (bytes reversed).
sysbus WriteByte 0x4009F060 0xC2   # l32i a12, a10, 4    (pxIndex = pxList->pxIndex)
sysbus WriteByte 0x4009F061 0x2A
sysbus WriteByte 0x4009F062 0x01
sysbus WriteByte 0x4009F063 0xD2   # l32i a13, a12, 8    (pxPrev = pxIndex->pxPrevious)
sysbus WriteByte 0x4009F064 0x2C
