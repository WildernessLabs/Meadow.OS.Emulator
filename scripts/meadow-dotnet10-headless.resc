using sysbus
include @peripherals/Winbond_W25QXXXJV.cs
include @peripherals/EspcpStub.cs
include @peripherals/QspiDmaBypass.cs
include @peripherals/EspcpSpiBypass.cs
include @peripherals/MqReceiveIntercept.cs
# include @peripherals/UartRxBypass.cs  # Disabled: API incompatibility with Renode 1.16.1
include @peripherals/STM32F7_RCC_Custom.cs
mach create "meadow-dotnet10"
machine LoadPlatformDescription @platforms/meadow-f7.repl

# RCC peripheral with proper clock ready bit handling
machine LoadPlatformDescriptionFromString "rcc: Miscellaneous.STM32F7_RCC_Custom @ sysbus 0x40023800"

# USB OTG FS stub — handles GRSTCTL polling (AHBIDL bit)
machine PyDevFromFile @scripts/pydev/otg_fs.py 0x50000000 0x40000 true "otg_fs"

# FMC (Flexible Memory Controller) stub — SDRAM init writes to 0xA0000000
machine PyDevFromFile @scripts/pydev/fmc.py 0xA0000000 0x1000 true "fmc"

# ESP32 coprocessor stub — starts booted and ready for SPI
# Re-trigger Reset after platform load so Ready/MessageWaiting GPIOs propagate
sysbus.spi2.espcpStub Reset

# Legacy memory layout:
#   vectors at 0x08040000 (uflash), kernel text at 0x08140000 (kflash),
#   user code at 0x08040200+ (uflash, after 512-byte vector table gap)
# Load user binary first, then overlay vector table on top (first 504 bytes)
sysbus LoadBinary @build/dotnet10/nuttx_user.bin 0x08040000
sysbus LoadBinary @build/dotnet10/nuttx_vectors.bin 0x08040000
sysbus LoadBinary @build/dotnet10/nuttx_kernel.bin 0x08140000

# Mono runtime — load into QSPI flash and SDRAM.
# nuttx_mono.bin starts at 0xC0000000 with the .mono_signature (32 bytes: magic, version,
# build date, git hash) followed by .mono code at 0xC0000020+.
# Load into QSPI for kernel flash reads, and into SDRAM at the ELF base address.
sysbus LoadBinary @build/dotnet10/nuttx_mono.bin 0x90000000
sysbus LoadBinary @build/dotnet10/nuttx_mono.bin 0xC0000000

# LittleFS filesystem image — pre-populated with .NET 10 assemblies
# File System partition starts at QSPI offset 0x500000 (see UART: "File System - Offset:0x00500000")
# Built by: tools/build_lfs_v1_image (LFS v1.7.2 format)
# Contains System.Private.CoreLib.dll + Meadow.dll at root (mounted as /meadow0/)
sysbus LoadBinary @build/dotnet10/littlefs.bin 0x90500000

sysbus.cpu VectorTableOffset 0x08040000

# Reset macro — called by Renode on SYSRESETREQ (NVIC AIRCR write).
# Reloads binaries and resets vector table so the firmware boots cleanly after restart.
macro reset
"""
    sysbus LoadBinary @build/dotnet10/nuttx_user.bin 0x08040000
    sysbus LoadBinary @build/dotnet10/nuttx_vectors.bin 0x08040000
    sysbus LoadBinary @build/dotnet10/nuttx_kernel.bin 0x08140000
    sysbus LoadBinary @build/dotnet10/nuttx_mono.bin 0x90000000
    sysbus LoadBinary @build/dotnet10/nuttx_mono.bin 0xC0000000
    # NOTE: Do NOT reload littlefs.bin here — it would overwrite deployed app files.
    # The LFS image is loaded once at initial boot; the firmware manages QSPI flash after that.
    sysbus.cpu VectorTableOffset 0x08040000
    sysbus.spi2.espcpStub Reset
    # Patch Mono's compiled-in /usr/local paths to /meadow0 (auto-generated)
    include @build/dotnet10/sdram-patches.resc
    # Mono runtime enabled — BBR bit 0x800 cleared (Track 04: monovm initialization)
    # Note: Without System.Private.CoreLib.dll deployed, hcom_mono_ctrl_are_needed_files_here()
    # will block mono startup. Deploy SPCL via Meadow CLI before testing mono init.
"""
runMacro $reset

# USART1: Console/syslog output to file
usart1 CreateFileBackend @/tmp/renode-uart-dotnet10.txt true

# UART4: HCOM transport — exposed as TCP socket on port 4242
emulation CreateServerSocketTerminal 4242 "hcom" false
connector Connect sysbus.uart4 hcom

# UART5: ESP32 control signal channel — exposed as TCP socket on port 4243
# Firmware's hcom_esp32_network_monitor_thread reads /dev/ttyS2 (UART5) for
# control signals: +++MW (message waiting), +++SIR (SPI ready), +++RDY, +++RST
emulation CreateServerSocketTerminal 4243 "esp32ctrl" false
connector Connect sysbus.uart5 esp32ctrl


# =============================================================================
# Hook definitions and SDRAM patches (auto-generated with resolved addresses)
# Template: scripts/meadow-legacy-hooks.resc
# Generated by: tools/extract-hook-addresses.py
# =============================================================================
include @build/dotnet10/hooks.resc
include @build/dotnet10/sdram-patches.resc


start
