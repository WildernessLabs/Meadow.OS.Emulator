using sysbus
mach create "meadow"
machine LoadPlatformDescription @platforms/meadow-f7.repl

sysbus LoadBinary @build/nuttx.bin 0x08000000
sysbus LoadBinary @build/nuttx_user.bin 0x08100000

sysbus.cpu VectorTableOffset 0x08000000

# Log USART1 output to console
showAnalyzer usart1

# Enable logging for debugging
logLevel 1

start

# Run for 10 virtual seconds then pause
machine ExecutionMode SingleStep
machine ExecutionMode Continuous
