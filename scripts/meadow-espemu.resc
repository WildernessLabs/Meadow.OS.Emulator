## Meadow Legacy OS with the ESP32 coprocessor running in esp-emu
##
## meadow-legacy-headless.resc with the EspcpStub replaced by EspEmuBridge:
## the real Meadow-ESP32 firmware (its ESP32-S3 emulator build) runs in
## Espressif's esp-emu, the STM32's SPI2 is its SPI master, and its UART0 is
## joined to the STM32's UART5, so the OS's espcp_uart_monitor gets +++RST,
## +++RDY, +++SIR and +++MW as on a board. PF7 drives the ESP's EN. See
## UseEspEmu.md.
##
## run.sh --esp-emu starts esp-emu before Renode:
##   esp-emu --chip esp32s3 --firmware build-esp32s3/merged_flash.bin \
##       --cosim-tcp 127.0.0.1:5590 --uart-tcp 127.0.0.1:$espemu_uart_port
## The co-simulation port (5590) is set in platforms/meadow-f7-espemu.repl.

$espemu_uart_port?=5591

using sysbus
include @peripherals/Winbond_W25QXXXJV.cs
include @peripherals/EspEmuBridge.cs
include @peripherals/QspiDmaBypass.cs
include @peripherals/EspcpSpiBypass.cs
include @peripherals/MqReceiveIntercept.cs
include @peripherals/UartRxBypass.cs
include @peripherals/STM32F7_RCC_Custom.cs
mach create "meadow-legacy"

# Loading the platform connects to esp-emu (which must already be running),
# holds the ESP in reset and, with quantumUs, holds its clock to this machine's.
machine LoadPlatformDescription @platforms/meadow-f7-espemu.repl

# RCC peripheral with proper clock ready bit handling
machine LoadPlatformDescriptionFromString "rcc: Miscellaneous.STM32F7_RCC_Custom @ sysbus 0x40023800"

# USB OTG FS stub — handles GRSTCTL polling (AHBIDL bit)
machine PyDevFromFile @scripts/pydev/otg_fs.py 0x50000000 0x40000 true "otg_fs"

# FMC (Flexible Memory Controller) stub — SDRAM init writes to 0xA0000000
machine PyDevFromFile @scripts/pydev/fmc.py 0xA0000000 0x1000 true "fmc"

# Legacy memory layout:
#   vectors at 0x08040000 (uflash), kernel text at 0x08140000 (kflash),
#   user code at 0x08040200+ (uflash, after 512-byte vector table gap)
# Load user binary first, then overlay vector table on top (first 504 bytes)
sysbus LoadBinary @build/legacy/nuttx_user.bin 0x08040000
sysbus LoadBinary @build/legacy/nuttx_vectors.bin 0x08040000
sysbus LoadBinary @build/legacy/nuttx_kernel.bin 0x08140000

# Mono runtime — load into QSPI flash and SDRAM.
sysbus LoadBinary @build/legacy/nuttx_mono.bin 0x90000000
sysbus LoadBinary @build/legacy/nuttx_mono.bin 0xC0000000

# LittleFS file system image: run.sh --mount=FILE (default none, the firmware
# formats an empty partition).  Load it once here, never in the reset macro.
include @build/legacy/fs-image.resc

# GDB server: run.sh --gdb[=PORT] or ports.gdb in the config (default off).
include @build/legacy/gdb.resc

sysbus.cpu VectorTableOffset 0x08040000

# Reset macro — called by Renode on SYSRESETREQ (NVIC AIRCR write).
# The ESP is not reset here: the OS resets it through PF7 as it starts, as on
# a board.
macro reset
"""
    sysbus LoadBinary @build/legacy/nuttx_user.bin 0x08040000
    sysbus LoadBinary @build/legacy/nuttx_vectors.bin 0x08040000
    sysbus LoadBinary @build/legacy/nuttx_kernel.bin 0x08140000
    sysbus LoadBinary @build/legacy/nuttx_mono.bin 0x90000000
    sysbus LoadBinary @build/legacy/nuttx_mono.bin 0xC0000000
    sysbus.cpu VectorTableOffset 0x08040000
    # Patch Mono's compiled-in /usr/local paths to /meadow0 (auto-generated)
    include @build/legacy/sdram-patches.resc
"""
runMacro $reset

# USART1: Console/syslog output to file
usart1 CreateFileBackend @/tmp/renode-uart-legacy.txt true

# UART4: HCOM transport — exposed as TCP socket on port 4242
emulation CreateServerSocketTerminal 4242 "hcom" false
connector Connect sysbus.uart4 hcom

# UART5: the ESP's UART0, through esp-emu's --uart-tcp. The ESP's log lines
# and control signals arrive here; the OS's espcp_uart_monitor reads /dev/ttyS2.
# A copy of the ESP's output goes to /tmp/renode-esp-uart.txt.
sysbus.spi2.espEmu EspLogFile @/tmp/renode-esp-uart.txt
sysbus.spi2.espEmu AttachUart sysbus.uart5 $espemu_uart_port

# =============================================================================
# Hook definitions and SDRAM patches (auto-generated with resolved addresses)
# Template: scripts/meadow-legacy-hooks.resc
# Generated by: tools/extract-hook-addresses.py
# EspcpSpiBypass finds EspEmuBridge and sends each ESPCP buffer as one transfer.
# ESPCP polling (0x2007FFF0) stays off: the ESP's +++MW drives the exchanges.
# =============================================================================
include @build/legacy/hooks.resc
include @build/legacy/sdram-patches.resc

start
