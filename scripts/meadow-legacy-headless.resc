using sysbus
include @peripherals/Winbond_W25QXXXJV.cs
include @peripherals/EspcpStub.cs
include @peripherals/QspiDmaBypass.cs
include @peripherals/SvcPrimaskFix.cs
include @peripherals/MqReceiveIntercept.cs
mach create "meadow-legacy"
machine LoadPlatformDescription @platforms/meadow-f7.repl

# RCC peripheral with proper clock ready bit handling
machine PyDevFromFile @scripts/pydev/rcc.py 0x40023800 0x400 true "rcc"

# USB OTG FS stub — handles GRSTCTL polling (AHBIDL bit)
machine PyDevFromFile @scripts/pydev/otg_fs.py 0x50000000 0x40000 true "otg_fs"

# FMC (Flexible Memory Controller) stub — SDRAM init writes to 0xA0000000
machine PyDevFromFile @scripts/pydev/fmc.py 0xA0000000 0x1000 true "fmc"

# ESP32 coprocessor stub — starts booted and ready for SPI
# Re-trigger Reset after platform load so Ready/MessageWaiting GPIOs propagate
sysbus.spi2.espcpStub Reset

# Legacy memory layout:
#   vectors at 0x08040000 (uflash), kernel text at 0x08140000 (kflash),
#   user code at 0x08040200+ (uflash, after 512-byte vector table gap)
# Load user binary first, then overlay vector table on top (first 504 bytes)
sysbus LoadBinary @build/legacy/nuttx_user.bin 0x08040000
sysbus LoadBinary @build/legacy/nuttx_vectors.bin 0x08040000
sysbus LoadBinary @build/legacy/nuttx_kernel.bin 0x08140000

# Mono runtime — load into QSPI flash and SDRAM.
# nuttx_mono.bin starts with the .mono code section (ELF linker address 0xC0000020) and does
# NOT include the 32-byte .mono_signature header. Load original binary into QSPI (for kernel
# reads), and the aligned binary (32 zero bytes prepended) into SDRAM so code lands at the
# correct ELF addresses. Then fill the 32-byte signature gap at 0xC0000000 with the first
# bytes of the original binary so the firmware's Mono presence check sees non-zero data.
sysbus LoadBinary @build/legacy/nuttx_mono.bin 0x90000000
sysbus LoadBinary @build/legacy/nuttx_mono_aligned.bin 0xC0000000
# Fill the 32-byte signature gap at 0xC0000000
sysbus WriteDoubleWord 0xC0000000 0x477008C0
sysbus WriteDoubleWord 0xC0000004 0x6849680B
sysbus WriteDoubleWord 0xC0000008 0x4718681B
sysbus WriteDoubleWord 0xC000000C 0x21002201
sysbus WriteDoubleWord 0xC0000010 0xBB71F004
sysbus WriteDoubleWord 0xC0000014 0xE92D4B23
sysbus WriteDoubleWord 0xC0000018 0xF8D341F0
sysbus WriteDoubleWord 0xC000001C 0x250030F0

# LittleFS filesystem image — pre-populated with Mono BCL assemblies
# File System partition starts at QSPI offset 0x500000 (see UART: "File System - Offset:0x00500000")
# Built by: tools/build_lfs_v1_image (LFS v1.7.2 format, compatible with legacy firmware)
sysbus LoadBinary @build/legacy/littlefs.bin 0x90500000

sysbus.cpu VectorTableOffset 0x08040000

# USART1: Console/syslog output to file
usart1 CreateFileBackend @/tmp/renode-uart-legacy.txt true

# UART4: HCOM transport — exposed as TCP socket on port 4242
emulation CreateServerSocketTerminal 4242 "hcom" false
connector Connect sysbus.uart4 hcom

# UART5: ESP32 control signal channel — exposed as TCP socket on port 4243
# Firmware's hcom_esp32_network_monitor_thread reads /dev/ttyS2 (UART5) for
# control signals: +++MW (message waiting), +++SIR (SPI ready), +++RDY, +++RST
emulation CreateServerSocketTerminal 4243 "esp32ctrl" false
connector Connect sysbus.uart5 esp32ctrl


# =============================================================================
# IronPython hooks
# Addresses extracted from: arm-none-eabi-nm build/legacy/nuttx.elf
# =============================================================================

# Workaround: Renode skips SVC when PRIMASK=1 instead of escalating to HardFault.
# SVC instruction addresses from: arm-none-eabi-objdump -d build/legacy/nuttx.elf | grep svc
# Uses compiled C# hook (SvcPrimaskFix.cs) instead of IronPython for performance.
# Critical for Mono JIT which makes thousands of syscalls/sec during assembly loading.
cpu InstallSvcFix 0x08163b5a 0x08163da6 0x08163db6 0x08163dc0 0x08163dcc 0x0817bd30

# Workaround: Force GPIO board version to CCMv2 (3).
# Hook meadow_hw_version_find_device_ver (0x08141970) at entry.
# Write initialized=1 and version=3 to hw_version struct at 0x20020ce4.
set gpio_ver_fix "machine.SystemBus.WriteByte(0x20020e74, 1); machine.SystemBus.WriteDoubleWord(0x20020e78, 3); cpu.PC = cpu.LR"
cpu AddHook 0x08141970 $gpio_ver_fix

# Workaround: Renode's STM32H7_QuadSPI doesn't set TCF in SR.
# qspi_waitstatusflags.constprop.0 = 0x08161f46
# qspi_waitstatusflags.part.0 = 0x08161e58
set qspi_wait_skip "cpu.PC = cpu.LR"
cpu AddHook 0x08161f46 $qspi_wait_skip
cpu AddHook 0x08161e58 $qspi_wait_skip

# Workaround: QUADSPI doesn't drive DMA requests — bypass qspi_memory with direct memcpy.
# qspi_memory = 0x08161f52 (entry point of qspi_memory function)
# Uses compiled C# hook (QspiDmaBypass.cs) instead of IronPython for 10-100x speedup.
# Critical for Mono JIT which makes millions of QSPI reads during assembly loading.
cpu InstallQspiBypass 0x08161f52 0x90000000

# Workaround: Mono runtime binary is pre-loaded into SDRAM via LoadBinary, but the firmware
# tries to copy it from QSPI flash (which is empty). Bypass the copy function to return 0 (success).
# hcom_via_nx_copy_mono_runtime_to_ram = 0x0805ebf0
set mono_copy_bypass "from Antmicro.Renode.Peripherals.CPU import RegisterValue; cpu.SetRegisterUnsafe(0, RegisterValue.Create(0, 32)); cpu.PC = cpu.LR"
cpu AddHook 0x0805ebf0 $mono_copy_bypass

# Workaround: Mono version check reads from QSPI flash MTD device (not memory-mapped).
# The MTD read goes through SPI commands to the GenericSpiFlash model, which may not see
# our LoadBinary data. Bypass hcom_nx_config_refresh_mono_version to write matching
# version info (firmware version) directly into the config struct.
# R0 = config pointer. Config layout:
#   +0x30..0x3C = firmware version numbers (4 dwords)
#   +0x54       = firmware short version string pointer
#   +0x5C..0x68 = mono version numbers (must match firmware)
#   +0x80       = mono short version string pointer (must be non-NULL)
#   +0x84       = mono long version string pointer
# Copy firmware version numbers to mono version, and copy firmware version string
# pointer to mono version string pointer so the NULL check in start_mono_main passes.
set mono_ver_bypass "r0 = cpu.GetRegisterUnsafe(0).RawValue; fw30 = machine.SystemBus.ReadDoubleWord(r0 + 0x30); fw34 = machine.SystemBus.ReadDoubleWord(r0 + 0x34); fw38 = machine.SystemBus.ReadDoubleWord(r0 + 0x38); fw3c = machine.SystemBus.ReadDoubleWord(r0 + 0x3c); machine.SystemBus.WriteDoubleWord(r0 + 0x5c, fw30); machine.SystemBus.WriteDoubleWord(r0 + 0x60, fw34); machine.SystemBus.WriteDoubleWord(r0 + 0x64, fw38); machine.SystemBus.WriteDoubleWord(r0 + 0x68, fw3c); fwstr = machine.SystemBus.ReadDoubleWord(r0 + 0x54); machine.SystemBus.WriteDoubleWord(r0 + 0x80, fwstr); machine.SystemBus.WriteDoubleWord(r0 + 0x84, fwstr); cpu.PC = cpu.LR"
cpu AddHook 0x08143590 $mono_ver_bypass

# Note: hcom_mono_ctrl_is_mono_enabled (0x080618e6) checks BBR bit 0x800.
# With BBR defaulting to 0, it naturally returns 1 (enabled) — no bypass needed.

# Workaround: hcom_mono_ctrl_start_mono_main checks config+0x80 (mono version string).
# The deep_copy_config doesn't copy our bypass-written value, so patch it directly.
# Hook at 0x08061940 (after deep_copy_config returns non-NULL in R0/R4):
# If config+0x80 is NULL, copy config+0x54 (firmware version string) to config+0x80.
set mono_str_fix "r0 = cpu.GetRegisterUnsafe(0).RawValue; monostr = machine.SystemBus.ReadDoubleWord(r0 + 0x80); fwstr = machine.SystemBus.ReadDoubleWord(r0 + 0x54); [machine.SystemBus.WriteDoubleWord(r0 + 0x80, fwstr), machine.SystemBus.WriteDoubleWord(r0 + 0x84, fwstr)] if monostr == 0 else None"
cpu AddHook 0x08061940 $mono_str_fix

# Workaround: start_mono_main scans for .NET assembly DLLs on the filesystem.
# Since no assemblies are deployed yet, bypass the check by forcing r4=0 (no missing files)
# at the end of the scan loop. This lets Mono start even without assemblies.
# hcom_mono_ctrl_start_mono_main+0x17c = 0x08061a74 (after scan loop, cmp r4, #0)
set asm_scan_bypass "from Antmicro.Renode.Peripherals.CPU import RegisterValue; cpu.SetRegisterUnsafe(4, RegisterValue.Create(0, 32))"
cpu AddHook 0x08061a74 $asm_scan_bypass

# Workaround: STM32SPI doesn't drive DMA — bypass espcp_send_data_over_spi with direct
# peripheral calls. Reads TX buffer from memory, feeds each byte through EspcpStub.Transmit(),
# writes returned bytes to RX buffer, then calls FinishTransmission() to trigger message handling.
# espcp_send_data_over_spi(void *tx, void *rx, size_t length) = 0x081488a0
# R0 = tx buffer (0 for receive-only), R1 = rx buffer (0 for send-only), R2 = buffer length
set espcp_spi_bypass "from System import Array, Byte; stub = [p.Peripheral for p in machine.GetRegisteredPeripherals() if type(p.Peripheral).__name__ == 'EspcpStub'][0]; tx = cpu.GetRegisterUnsafe(0).RawValue; rx = cpu.GetRegisterUnsafe(1).RawValue; length = int(cpu.GetRegisterUnsafe(2).RawValue); txdata = machine.SystemBus.ReadBytes(tx, length) if tx else Array.CreateInstance(Byte, length); rxarr = Array.CreateInstance(Byte, length); [rxarr.__setitem__(i, stub.Transmit(txdata[i])) for i in range(length)]; stub.FinishTransmission(); machine.SystemBus.WriteBytes(rxarr, rx) if rx else None; cpu.PC = cpu.LR"
cpu AddHook 0x081488a0 $espcp_spi_bypass

# Workaround: Force ESPCP initialization by setting selected network type to WiFi (1).
# hcom_nx_setup_mgr gates espcp_late_init on config[8] & 0xFF — if 0, ESPCP is skipped.
# At 0x08141d50 (ands.w r0, r5, #255), R5 holds config[8]. Force R5=1 so branch is not taken.
set espcp_force_init "from Antmicro.Renode.Peripherals.CPU import RegisterValue; cpu.SetRegisterUnsafe(5, RegisterValue.Create(1, 32))"
cpu AddHook 0x08141d50 $espcp_force_init

# Workaround: ESPCP SPI lock semaphore starts at 0 — first espcp_spi_interface_lock blocks.
# Since we bypass real SPI with the DMA bypass hook, skip the lock/unlock entirely.
set spi_lock_skip "cpu.PC = cpu.LR"
cpu AddHook 0x08148918 $spi_lock_skip
cpu AddHook 0x08148924 $spi_lock_skip

# Workaround: LSI clock calibration thread polls Timer 5 capture/compare which
# Renode doesn't emulate. Skip the thread function to avoid burning CPU.
# pwrmgmt_lsi_calc_prep_thread_func = 0x0814dbe8
set lsi_skip "cpu.PC = cpu.LR"
cpu AddHook 0x0814dbe8 $lsi_skip

# Post-boot ESPCP polling via mq_receive intercept.
# Uses compiled C# hook (MqReceiveIntercept.cs) instead of IronPython for performance.
# Fires on ALL mq_receive calls system-wide; must be fast.
cpu InstallMqIntercept 0x08157c40 0x0814e95b 0x2007C010 0x2007FFF0

# ESPCP post-boot polling disabled during Mono init to avoid CPU starvation.
# Enable later via: sysbus WriteByte 0x2007FFF0 1
# set espcp_poll_enable "machine.SystemBus.WriteByte(0x2007FFF0, 1)"
# cpu AddHook 0x0814e938 $espcp_poll_enable

# Workaround: Mono was built with --prefix=/usr/local (default), so its compiled-in lib
# directory is "/usr/local/lib" and it looks for BCL at /usr/local/lib/mono/4.5/.
# Patch the string in SDRAM to "/meadow0" so Mono looks at /meadow0/mono/4.5/ instead.
# The LittleFS image has assemblies at /mono/4.5/ which maps to /meadow0/mono/4.5/.
# String "/usr/local/lib\0" at SDRAM 0xC016D79C → "/meadow0\0\0\0\0\0\0\0"
sysbus WriteDoubleWord 0xC016D79C 0x61656D2F
sysbus WriteDoubleWord 0xC016D7A0 0x30776F64
sysbus WriteDoubleWord 0xC016D7A4 0x00000000
sysbus WriteByte 0xC016D7A8 0x00
sysbus WriteByte 0xC016D7A9 0x00
# Also patch "/usr/local/etc\0" at SDRAM 0xC0175C4E → "/meadow0\0"
sysbus WriteDoubleWord 0xC0175C4E 0x61656D2F
sysbus WriteDoubleWord 0xC0175C52 0x30776F64
sysbus WriteDoubleWord 0xC0175C56 0x00000000

# Workaround: Prevent LittleFS format from wiping pre-populated filesystem data.
# The firmware tries mount first (NULL options); if that fails with -EFAULT/-EINVAL,
# it retries with "forceformat" which calls lfs_format() before lfs_mount().
# Skip lfs_format entirely (return 0 = LFS_ERR_OK) to preserve our BCL assemblies.
# lfs_format = 0x08171df6
set lfs_format_skip "from Antmicro.Renode.Peripherals.CPU import RegisterValue; cpu.SetRegisterUnsafe(0, RegisterValue.Create(0, 32)); cpu.PC = cpu.LR"
cpu AddHook 0x08171df6 $lfs_format_skip

start
